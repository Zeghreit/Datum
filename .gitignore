_trash*/
# sound: the heavy originals from the generators stay out, the .ogg that
# datum_audio.py makes from them goes in — it is what the build bakes, it is a
# few hundred kb, and nothing in sfx/ can be regenerated from scratch.
sfx/*.mp3
sfx/*.wav
sfx/*.m4a
sfx/spare/
sfx/_raw/
